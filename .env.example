# ==============================================================================
# TruthLens Environment Configuration
# ==============================================================================

# Data and Persistence Paths
TRUTHLENS_DATA_DIR=data
TRUTHLENS_API_URL=http://127.0.0.1:8000

# Security & CORS
# Comma-separated list of allowed origins for the FastAPI backend
TRUTHLENS_CORS_ORIGINS=http://localhost:8501,http://127.0.0.1:8501,http://localhost:8000,http://127.0.0.1:8000

# Ingest and Batch Caps
TRUTHLENS_LIMIT_MAX_FILES_PER_BATCH=10
TRUTHLENS_LIMIT_MAX_BATCH_BYTES=209715200
TRUTHLENS_LIMIT_MAX_UPLOAD_FILE_BYTES=209715200

# Multimodal Eligibility Limits
TRUTHLENS_LIMIT_IMAGE_MAX_BYTES=20971520
TRUTHLENS_LIMIT_IMAGE_MAX_PIXELS=100000000
TRUTHLENS_LIMIT_VIDEO_MAX_BYTES=104857600
TRUTHLENS_LIMIT_VIDEO_MAX_DURATION_SECONDS=10.0
TRUTHLENS_LIMIT_AUDIO_MAX_BYTES=26214400
TRUTHLENS_LIMIT_AUDIO_MAX_DURATION_SECONDS=20.0
TRUTHLENS_LIMIT_DOCUMENT_MAX_BYTES=10485760
TRUTHLENS_LIMIT_TEXT_MAX_CHARACTERS=100000
TRUTHLENS_LIMIT_STRUCTURED_MAX_BYTES=10485760
TRUTHLENS_LIMIT_STRUCTURED_MAX_CHARACTERS=100000

# Audio Deepfake Detection (ONNX)
TRUTHLENS_AUDIO_DEEPFAKE_MODEL=ai8shiro/deepfake-audio-wav2vec2-ONNX
TRUTHLENS_AUDIO_DEEPFAKE_REVISION=78a7991b7f413bd6ce15efd7cb27000736acc78a
TRUTHLENS_AUDIO_DEEPFAKE_FILE=onnx/model_q4.onnx
TRUTHLENS_AUDIO_DEEPFAKE_DEVICE=cpu
TRUTHLENS_AUDIO_DEEPFAKE_MAX_SECONDS=20.0

# Optional Audio Transcription (faster-whisper)
TRUTHLENS_TRANSCRIPTION_MODEL=tiny
TRUTHLENS_TRANSCRIPTION_REVISION=d90ca5fe260221311c53c58e660288d3deb8d356
TRUTHLENS_TRANSCRIPTION_DEVICE=cpu
TRUTHLENS_TRANSCRIPTION_COMPUTE=int8
